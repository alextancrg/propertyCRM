// Prisma schema for AssetHub (property management CRM)
// Local development: SQLite (works out of the box).
// Vercel production: switch `provider` to "postgresql" and set DATABASE_URL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                  String              @id @default(cuid())
  name                String
  email               String              @unique
  phone               String?
  passwordHash        String?
  role                String              @default("Property Manager")
  language            String              @default("en") // en | ms | zh-CN — WhatsApp template language for this user's messages
  auditLogs           AuditLog[]
  createdOwners       Owner[]             @relation("OwnerCreatedBy") // owners this manager registered
  managedOwners       OwnerManager[]      // owners assigned to this manager
  rentOverrides       RentPayment[]       // rental payments the manager confirmed without a slip
  subscription        Subscription?       // the manager's paid plan (Stripe-backed)
  feedback            Feedback[]          // support messages submitted by this user
  sentInvitations     ManagerInvitation[] @relation("InvitationFrom")
  receivedInvitations ManagerInvitation[] @relation("InvitationTo")
  sharingA            ManagerSharing[]    @relation("ManagerSharingA")
  sharingB            ManagerSharing[]    @relation("ManagerSharingB")
  aiAuthorizedTenants AiAuthorizedTenant[]
  whatsAppMessages    WhatsAppMessageLog[]
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @default(now()) @updatedAt
}

// A property manager's paid subscription plan (Stripe). The plan is denormalised
// here so the subscription record carries the plan + status; the property limit
// is derived from the plan config in src/lib/plans.ts.
model Subscription {
  id                   String    @id @default(cuid())
  userId               String    @unique
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                 String    @default("free") // free | starter | growth | pro | business
  status               String    @default("active") // active | trialing | past_due | canceled | unpaid
  propertyLimit        Int?      // denormalised copy; null = unlimited (Business/Admin)
  stripeCustomerId     String?
  stripeSubscriptionId String?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @default(now()) @updatedAt
}

// Support / feedback submissions. Stored so users can review their history and
// admins can triage. An email is also sent to the support inbox.
model Feedback {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  name      String
  email     String // the logged-in user's email (replies go here)
  category  String  // Feature Request | Bug Report | Question | Other
  subject   String
  message   String
  status    String   @default("new") // new | open | resolved
  createdAt DateTime @default(now())
}

model Owner {
  id               String          @id @default(cuid())
  name             String
  icNumber         String?
  phone            String?
  email            String?
  createdById      String? // the property manager who registered this owner
  createdBy        User?           @relation("OwnerCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  deletedAt        DateTime? // soft delete — keeps history/documents/bills intact
  properties       PropertyOwner[]
  assignedManagers OwnerManager[] // additional managers allowed to manage this owner's properties
  createdAt        DateTime        @default(now())
}

model Property {
  id            String          @id @default(cuid())
  name          String
  type          String          // Apartment | Condominium | Villa
  address       String
  location      String
  status        PropertyStatus  @default(VACANT)
  rent          Float           @default(0) // actual rent (not target)
  rentStartDate DateTime?       // first rent collection date (drives rent due reminders)
  rentGraceDays Int             @default(7) // grace period (days) after rent is due before it becomes overdue
  soldDate      DateTime?       // recorded when the unit is sold
  deletedAt     DateTime?       // soft delete — keeps documents & older bills intact
  remarks       String?         // free text, up to 300 characters
  isOwnStay     Boolean         @default(false) // own-stay unit: no rental collection, excluded from tax
  unitName      String?         // unit name/number within the property (e.g. "Room 1")
  unitTags      String?         // comma-separated unit tags shown as chips (e.g. "Female Only, Private Bathroom")
  utilityDeposit Float          @default(0) // utility deposit collected from the tenant (RM)
  meterMode     String?         // default meter mode: Prepaid | Postpaid
  meterRate     Float?          // default meter rate (RM/kWh)
  template      String?         // billing/lease template label
  nextCheckInDate DateTime?     // estimated check-in of the next tenant after a notified checkout
  owners        PropertyOwner[]
  leases        Lease[]
  bills         Bill[]
  expenses      Expense[]
  annualIncomes AnnualIncome[]
  documents     Document[]
  whatsAppMessages WhatsAppMessageLog[]
  createdAt     DateTime        @default(now())
}

model AnnualIncome {
  id          String   @id @default(cuid())
  propertyId  String
  year        Int
  grossAmount Float   @default(0) // legacy full-override (kept for older records)
  manualRent  Float   @default(0) // additional manual rental collection (e.g. before the lease) — adds to auto-collected rent
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, year])
}

model PropertyOwner {
  id          String   @id @default(cuid())
  propertyId  String
  ownerId     String
  sharePercent Float   @default(100)
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  owner       Owner    @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([propertyId, ownerId])
}
// A property manager assigned to help manage an owner's properties.
model OwnerManager {
  id      String @id @default(cuid())
  ownerId String
  userId  String
  owner   Owner  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([ownerId, userId])
}

// A property manager invitation — add another manager by email to share
// property visibility. The invitee must accept before visibility is shared.
model ManagerInvitation {
  id          String   @id @default(cuid())
  fromUserId  String
  fromUser    User     @relation("InvitationFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  email       String   // the invited manager's login email
  status      String   @default("pending") // pending | accepted | declined
  token       String   @unique
  toUserId    String?  // set when accepted — the invited user
  toUser      User?    @relation("InvitationTo", fields: [toUserId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  respondedAt DateTime?
}

// An accepted, bidirectional visibility link between two property managers.
// Sharing is transitive: managers in the same connected component of this
// graph see each other's properties.
model ManagerSharing {
  id        String   @id @default(cuid())
  userAId   String
  userBId   String
  userA     User     @relation("ManagerSharingA", fields: [userAId], references: [id], onDelete: Cascade)
  userB     User     @relation("ManagerSharingB", fields: [userBId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userAId, userBId])
}
model Tenant {
  id               String   @id @default(cuid())
  name             String
  phone            String?
  language         String   @default("en") // en | ms | zh-CN — WhatsApp template language for this tenant
  email            String?
  icNumber         String?
  leases           Lease[]
  documents        Document[]
  aiAuthorizedBy   AiAuthorizedTenant[]
  whatsAppMessages WhatsAppMessageLog[]
  createdAt        DateTime @default(now())
}

model Lease {
  id          String      @id @default(cuid())
  propertyId  String
  tenantId    String
  startDate   DateTime
  endDate     DateTime?
  monthlyRent Float
  deposit     Float       @default(0)
  status      LeaseStatus @default(ACTIVE)
  stampedAt   DateTime?
  stampingRef String?
  checkoutNotified Boolean  @default(false) // tenant informed they will vacate at lease end
  checkoutDate     DateTime? // the date the tenant said they will vacate (usually lease end)
  leaseEndRemarks  String?   // free text about the lease end, up to 300 characters
  property    Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rentPayments RentPayment[]
  reminders   RentReminder[]
  createdAt   DateTime    @default(now())
}

model Bill {
  id          String        @id @default(cuid())
  propertyId  String
  type        String        // Electricity | Water | Sewerage | Management Fee | Quit Rent | Assessment Tax
  provider    String
  schedule    String        // Monthly | Quarterly | Half-Yearly | Annually
  amountType  String        // Variable | Fixed
  fixedAmount Float?
  year             Int           @default(2026) // billing year for the configured due dates
  dueDates         String        @default("[]") // JSON array of "YYYY-MM-DD" (pattern for the schedule)
  remarks          String?       // free text, up to 300 characters
  tenantPrepaid    Boolean       @default(false) // tenant prepaid the total sewerage for the whole lease tenure
  tenantPrepayAmount Float?      // RM collected up front from the tenant
  tenantPrepayNote String?       // how the prepayment was computed (tenure span x rate)
  property         Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  payments    BillPayment[]
  createdAt   DateTime      @default(now())
}

model BillPayment {
  id         String     @id @default(cuid())
  billId     String
  cycle      String     // e.g. "Aug 2026", "Q3 2026"
  dueDate    DateTime?
  amount     Float      @default(0)
  status     BillStatus @default(UNPAID)
  paidAt     DateTime?
  receiptUrl String?
  remarks    String?    // per-cycle remarks, up to 300 characters
  bill       Bill       @relation(fields: [billId], references: [id], onDelete: Cascade)
  receipts   BillReceipt[]
  createdAt  DateTime   @default(now())
}

model BillReceipt {
  id         String      @id @default(cuid())
  paymentId  String
  fileName   String
  mimeType   String      @default("application/octet-stream")
  data       String      // base64-encoded file bytes (persisted so downloads work on any host)
  size       Int         @default(0)
  payment    BillPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  uploadedAt DateTime    @default(now())
}

model Expense {
  id          String   @id @default(cuid())
  propertyId  String
  category    String
  description String
  amount      Float
  incurredAt  DateTime @default(now())
  receiptUrl  String?
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

model RentPayment {
  id           String     @id @default(cuid())
  leaseId      String
  month        String     // e.g. "2026-08"
  amount       Float
  status       BillStatus @default(UNPAID)
  paidAt       DateTime?
  receiptUrl   String?    // payment slip (PDF/image) uploaded when marking paid
  receiptData  String?    // base64-encoded bytes persisted so slips download on any host
  receiptMime  String?    // original MIME type of the slip
  remarks      String?    // per-month notes
  overrideById String?    // PM who confirmed a paid update without a payment slip
  overrideAt   DateTime?
  overrideBy   User?      @relation(fields: [overrideById], references: [id], onDelete: SetNull)
  lease        Lease      @relation(fields: [leaseId], references: [id], onDelete: Cascade)

  @@unique([leaseId, month])
}

model RentReminder {
  id      String    @id @default(cuid())
  leaseId String
  month   String    // e.g. "2026-08"
  stage   String    // D-3 | D+1 | D+3 | ESCALATED
  message String
  dueDate DateTime?
  self    Boolean   @default(false) // true = self WhatsApp escalation (red highlighted)
  sentAt  DateTime  @default(now())
  lease   Lease     @relation(fields: [leaseId], references: [id], onDelete: Cascade)
}

model Document {
  id         String    @id @default(cuid())
  propertyId String?
  tenantId   String?
  category   String    // Lease Agreement | Receipt | Insurance | Warranty | Title | Compliance
  title      String
  fileUrl    String?
  fileData   String?   // base64-encoded bytes persisted so documents download on any host
  fileMime   String?   // original MIME type of the document
  fileData2  String?   // optional 2nd attachment (base64) — a document holds up to 2 files
  fileMime2  String?   // original MIME type of the 2nd attachment
  isStamped  Boolean   @default(false)
  year       Int?      // lease start year — used for year filtering / grouping
  leaseFrom  DateTime? // lease start date (tenure) — drives the year search
  leaseTo    DateTime? // lease end date; null = open-ended (until further notice)
  uploadedAt DateTime  @default(now())
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  tenant     Tenant?   @relation(fields: [tenantId], references: [id], onDelete: SetNull)
}

model AuditLog {
  id          String   @id @default(cuid())
  entityType  String
  entityId    String?
  action      String
  description String
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
}

model AiAgentConfig {
  id                     String   @id @default("default")
  enabled                Boolean  @default(true)
  provider               String   @default("deepseek")
  model                  String   @default("deepseek-v4-flash")
  systemPrompt           String
  greeting               String
  escalationEmail        String?
  autonomyLevel          String   @default("semi") // semi | full
  autoRentReminder       Boolean  @default(true)
  autoMaintenanceTriage  Boolean  @default(true)
  autoViewingSchedule    Boolean  @default(true)
  tenantNames            String   @default("") // comma-separated names the agent is allowed to message
  reminderDays1          Int      @default(-3) // rent alert 1: days relative to due date (negative = before)
  reminderDays2          Int      @default(1) // rent alert 2: days relative to due date
  reminderDays3          Int      @default(3) // rent alert 3: days relative to due date
  reminderEscalationDays Int      @default(6) // self-escalation: days overdue before the red self-WhatsApp alert
  updatedAt              DateTime @updatedAt
}

model ChatMessage {
  id        String   @id @default(cuid())
  sessionId String
  role      String   // ai | tenant
  content   String
  createdAt DateTime @default(now())
}

// A tenant explicitly authorised by a property manager for the WhatsApp AI
// agent to contact. Eligible tenants (those with active leases on the units the
// manager manages) are offered in the AI Agent settings as a dropdown; the
// manager adds/removes them here. Expired-lease tenants are pruned automatically.
model AiAuthorizedTenant {
  id        String   @id @default(cuid())
  userId    String
  tenantId  String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([tenantId])
}

// Every outbound WhatsApp attempt by the AI agent (or the reminder engine).
// Used to (a) enforce the plan's monthly message quota, (b) show the manager how
// many messages remain, and (c) power the Dashboard's "AI Agent Actions" feed —
// the same tenant can appear multiple times with one row per attempt datetime.
model WhatsAppMessageLog {
  id           String    @id @default(cuid())
  userId       String?   // manager who triggered the message (null for global/cron runs)
  tenantId     String?   // targeted tenant (null for self/manager alerts)
  propertyId   String?   // unit involved (scoping for dashboard visibility)
  tenantName   String?   // snapshot of the recipient name
  propertyName String?   // snapshot of the unit name
  action       String    // RENT_REMINDER | CHAT_REPLY | MAINTENANCE | VIEWING | SELF_ALERT | AUTO_REMOVED
  status       String    @default("SENT") // SENT | SKIPPED_QUOTA | TWILIO_NOT_CONFIGURED | FAILED
  recipient    String?   // E.164 phone the message was addressed to
  message      String?   // snapshot of the message body
  createdAt    DateTime  @default(now())
  user         User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  tenant       Tenant?   @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  property     Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
}

enum PropertyStatus {
  LEASED
  VACANT
  ARREARS
  SOLD
}

enum LeaseStatus {
  ACTIVE
  EXPIRED
  TERMINATED
  PENDING
}

enum BillStatus {
  PAID
  UNPAID
}
